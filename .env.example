# Core settings
OPPORTUNITY_RADAR_DB=data/opportunities.sqlite3
OPPORTUNITY_RADAR_REPORT_DIR=data/reports
OPPORTUNITY_RADAR_LOG_LEVEL=INFO

# DeepSeek intelligence layers
# Never commit a real key. GitHub Actions reads the repository secret DEEPSEEK_API_KEY.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
OPPOR_LLM_ITEM_BATCH=32

# Optional daily email delivery (SMTP; Gmail app passwords work)
OR_EMAIL_ENABLED=false
OR_EMAIL_TO=
OR_EMAIL_FROM=
OR_SMTP_HOST=smtp.gmail.com
OR_SMTP_PORT=465
OR_SMTP_USERNAME=
OR_SMTP_PASSWORD=
OR_PUBLIC_URL=https://ranchotao.com/Oppor-Radar/
