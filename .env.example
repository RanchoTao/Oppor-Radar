# Core settings
OPPORTUNITY_RADAR_DB=data/opportunities.sqlite3
OPPORTUNITY_RADAR_REPORT_DIR=data/reports
OPPORTUNITY_RADAR_LOG_LEVEL=INFO

# DeepSeek daily digest
# Do not commit a real API key. For GitHub Actions, store it as a repository secret named DEEPSEEK_API_KEY.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
OPPOR_LLM_MAX_ITEMS=120
